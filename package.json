{
  "name": "universal-media-converter",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node --experimental-strip-types --import ./scripts/test-loader.mjs --test packages/conversion-core/test/*.test.ts apps/worker/test/*.test.ts apps/api/test/*.test.ts",
    "test:unit": "node --experimental-strip-types --import ./scripts/test-loader.mjs --test packages/conversion-core/test/*.test.ts apps/worker/test/*.test.ts apps/api/test/*.test.ts",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0"
  }
}
