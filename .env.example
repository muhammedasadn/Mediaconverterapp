# ==============================================================================
# Universal Media Converter — Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Application (@universal/web)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Universal Media Converter"

# ------------------------------------------------------------------------------
# 2. Fastify API Server (@universal/api)
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=/tmp/universal-media/uploads
OUTPUT_DIR=/tmp/universal-media/output

# ------------------------------------------------------------------------------
# 3. Redis & BullMQ Queue
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Background Conversion Worker (@universal/worker)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
STORAGE_TTL_MS=3600000       # 1 Hour TTL auto-eviction of converted assets
CLEANUP_INTERVAL_MS=300000   # 5 Minute cron interval for disk sanitation
LOG_LEVEL=info
