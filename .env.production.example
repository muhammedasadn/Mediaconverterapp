# ----------------------------------------------------------------------------
# Universal Media Converter — Production VM Environment Variables
# Copy to /home/converter/.env on the VM with permissions 600
# ----------------------------------------------------------------------------

# Domain & Edge Routing
API_DOMAIN=api.universalmediaconverter.app
ALLOWED_ORIGIN=https://universalmediaconverter.pages.dev
ACME_EMAIL=admin@universalmediaconverter.app

# Redis Credentials (Generate with `openssl rand -hex 32`)
REDIS_PASSWORD=change_this_to_a_secure_random_64_char_hex_secret

# Storage Limits
MAX_IMPORT_SIZE_MB=500
UPLOAD_DIR=/var/lib/media-storage/uploads
OUTPUT_DIR=/var/lib/media-storage/output

# Worker Configuration
CONCURRENCY=2
FF_THREADS=2
STORAGE_TTL_MS=3600000
CLEANUP_INTERVAL_MS=300000
